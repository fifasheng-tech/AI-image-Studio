# Copy to .env and fill in your own values. Never commit .env.

PORT=3487

# Image generation provider (required)
FIGURE_API_KEY=
FIGURE_BASE_URL=https://api.figure.jiangsuocean.cn
FIGURE_FALLBACK_BASE_URL=https://figure.jiangsuocean.cn
FIGURE_IMAGE_MODEL=gpt-image-2

# Optional alternate provider
YOUMISUB_IMAGE_BASE_URL=
YOUMISUB_IMAGE_KEY=
YOUMISUB_IMAGE_MODEL=gpt-image-2

# Optional path to generation script (defaults to ./scripts/generate.py)
# GENERATE_SCRIPT_PATH=./scripts/generate.py

# Optional output directory (defaults to ./tmp/outputs)
# IMAGE_STUDIO_OUTPUT_DIR=./tmp/outputs

# Optional prompt-enhancement LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5
# GPT_PROMPT_MODEL=gpt-5.5

# Optional inpaint backend
# IOPAINT_URL=http://127.0.0.1:8080
